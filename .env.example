# Beispiel-Konfiguration für den Server-Betrieb
# Kopieren nach .env und Werte setzen:  cp .env.example .env

# Benutzername für den Login (Standard: admin)
APP_USER=admin

# Passwort im Klartext (schnell) – ODER besser den Hash darunter verwenden
APP_PASSWORD=

# scrypt-Hash des Passworts (bevorzugt). Erzeugen mit:
#   python -c "import os,hashlib; s=os.urandom(16).hex(); print('APP_PASSWORD_HASH=scrypt$16384$8$1$'+s+'$'+hashlib.scrypt(b'MEIN_PASSWORT',salt=bytes.fromhex(s),n=16384,r=8,p=1).hex())"
APP_PASSWORD_HASH=

# Zufällige Session-Signatur (leer = wird automatisch in data/secret_key erzeugt)
APP_SECRET=
